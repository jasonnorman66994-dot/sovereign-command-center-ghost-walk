{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityThreatAlert",
  "type": "object",
  "properties": {
    "alert_type": { "type": "string", "enum": ["identity_compromise", "identity_endpoint_compromise"] },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "user": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "user_id": { "type": "string" },
        "display_name": { "type": "string" },
        "department": { "type": "string" },
        "role": { "type": "string" },
        "privileged_access": { "type": ["string", "boolean"] }
      },
      "required": ["email", "user_id"]
    },
    "event": {
      "type": "object",
      "properties": {
        "event_type": { "type": "string" },
        "description": { "type": "string" },
        "source_ip": { "type": "string" },
        "asn": { "type": "string" },
        "geo_location": { "type": "string" },
        "client_app": { "type": "string" },
        "auth_method": { "type": "string" },
        "risk_level": { "type": "string" },
        "risk_detections": { "type": "array", "items": { "type": "string" } },
        "correlation_id": { "type": "string" },
        "session_id": { "type": "string" }
      },
      "required": ["event_type", "description", "source_ip"]
    },
    "technical_indicators": {
      "type": "object",
      "properties": {
        "mfa_fatigue_count": { "type": ["integer", "string"] },
        "legacy_protocol_used": { "type": ["boolean", "string"] },
        "oauth_app_detected": { "type": ["boolean", "string"] },
        "oauth_app_scopes": { "type": "array", "items": { "type": "string" } },
        "hidden_inbox_rules_detected": { "type": ["boolean", "string"] },
        "impossible_travel_detected": { "type": ["boolean", "string"] },
        "token_replay_detected": { "type": ["boolean", "string"] },
        "new_device_registration": { "type": ["boolean", "string"] },
        "unfamiliar_signin_properties": { "type": ["boolean", "string"] }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "investigation_links": {
      "type": "object",
      "properties": {
        "signin_logs": { "type": "string", "format": "uri" },
        "oauth_apps": { "type": "string", "format": "uri" },
        "inbox_rules": { "type": "string", "format": "uri" },
        "sentinel_query": { "type": "string", "format": "uri" },
        "user_profile": { "type": "string", "format": "uri" }
      }
    },
    "assigned_to": {
      "type": "object",
      "properties": {
        "analyst": { "type": "string" },
        "team": { "type": "string" }
      },
      "required": ["analyst"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "pipeline_version": { "type": "string" },
        "source_system": { "type": "string" },
        "environment": { "type": "string" }
      }
    }
  },
  "required": ["alert_type", "severity", "timestamp_utc", "user", "event", "recommended_actions", "assigned_to"]
}
