FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt requirements-phishing-detector.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-phishing-detector.txt

COPY . .

EXPOSE 8061

CMD ["uvicorn", "rf_calibration_api:app", "--host", "0.0.0.0", "--port", "8061"]
