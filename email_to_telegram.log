;5 new connections&quot;, &quot;preview&quot;: &quot;Check out who wants to connect&quot;, &quot;date&quot;: &quot;2026-01-06T11:00:00&quot;, &quot;priority&quot;: &quot;low&quot;, &quot;category&quot;: &quot;social&quot;, &quot;starred&quot;: False, &quot;read&quot;: True},\r\n&gt; {&quot;id&quot;: 6, &quot;from&quot;: &quot;billing@service.com&quot;, &quot;subject&quot;: &quot;Invoice 12345&quot;, &quot;preview&quot;: &quot;Your invoice is available&quot;, &quot;date&quot;: &quot;2026-01-05T10:30:00&quot;, &quot;priority&quot;: &quot;medium&quot;, &quot;category&quot;: &quot;finance&quot;, &quot;starred&quot;: False, &quot;read&quot;: False},\r\n&gt; ]\r\n&gt; \r\n&gt; def filter_by_category(emails, category):\r\n&gt;     if category.lower() == &quot;all&quot;:\r\n&gt;         return emails\r\n&gt;     return [e for e in emails if e[&quot;category&quot;].lower() == category.lower()]\r\n&gt; \r\n&gt; def search_emails(emails, query):\r\n&gt;     query = query.lower()\r\n&gt;     results = []\r\n&gt;     for email in emails:\r\n&gt;         if query in email[&quot;from&quot;].lower() or query in email[&quot;subject&quot;].lower() or query in email[&quot;preview&quot;].lower():\r\n&gt;             results.append(email)\r\n&gt;     return results\r\n&gt; \r\n&gt; def display_email(email, index):\r\n&gt;     print(&quot;\\n&quot; + &quot;=&quot;*60)\r\n&gt;     print(f&quot;[{index}] From: {email[&#39;from&#39;]}&quot;)\r\n&gt;     print(f&quot;Subject: {email[&#39;subject&#39;]}&quot;)\r\n&gt;     print(f&quot;Category: {email[&#39;category&#39;]} | Priority: {email[&#39;priority&#39;]}&quot;)\r\n&gt;     print(f&quot;Preview: {email[&#39;preview&#39;]}&quot;)\r\n&gt; \r\n&gt; def display_results(emails, title):\r\n&gt;     print(&quot;\\n&quot; + &quot;=&quot;*60)\r\n&gt;     print(f&quot;  {title} - Total: {len(emails)}&quot;)\r\n&gt;     print(&quot;=&quot;*60)\r\n&gt;     if not emails:\r\n&gt;         print(&quot;No emails found.&quot;)\r\n&gt;         return\r\n&gt;     for i, email in enumerate(emails, 1):\r\n&gt;         display_email(email, i)\r\n&gt;     print(&quot;\\n&quot; + &quot;=&quot;*60)\r\n&gt; \r\n&gt; def main():\r\n&gt;     while True:\r\n&gt;         print(&quot;\\n=== EMAIL SORTER ===&quot;)\r\n&gt;         print(&quot;1. All emails&quot;)\r\n&gt;         print(&quot;2. Work emails&quot;)\r\n&gt;         print(&quot;3. Newsletter emails&quot;)\r\n&gt;         print(&quot;4. Social emails&quot;)\r\n&gt;         print(&quot;5. Finance emails&quot;)\r\n&gt;         print(&quot;6. Search emails&quot;)\r\n&gt;         print(&quot;0. Exit&quot;)\r\n&gt;         \r\n&gt;         choice = input(&quot;\\nChoice: &quot;)\r\n&gt;         \r\n&gt;         if choice == &quot;0&quot;:\r\n&gt;             print(&quot;Goodbye!&quot;)\r\n&gt;             break\r\n&gt;         elif choice == &quot;1&quot;:\r\n&gt;             display_results(EMAILS, &quot;All Emails&quot;)\r\n&gt;         elif choice == &quot;2&quot;:\r\n&gt;             display_results(filter_by_category(EMAILS, &quot;work&quot;), &quot;Work Emails&quot;)\r\n&gt;         elif choice == &quot;3&quot;:\r\n&gt;             display_results(filter_by_category(EMAILS, &quot;newsletter&quot;), &quot;Newsletters&quot;)\r\n&gt;         elif choice == &quot;4&quot;:\r\n&gt;             display_results(filter_by_category(EMAILS, &quot;social&quot;), &quot;Social Emails&quot;)\r\n&gt;         elif choice == &quot;5&quot;:\r\n&gt;             display_results(filter_by_category(EMAILS, &quot;finance&quot;), &quot;Finance Emails&quot;)\r\n&gt;         elif choice == &quot;6&quot;:\r\n&gt;             query = input(&quot;Search term: &quot;)\r\n&gt;             display_results(search_emails(EMAILS, query), f&quot;Search: {query}&quot;)\r\n&gt;         else:\r\n&gt;             print(&quot;Invalid choice&quot;)\r\n&gt;         \r\n&gt;         input(&quot;\\nPress Enter...&quot;)\r\n&gt; \r\n&gt; if __name__ == &quot;__main__&quot;:\r\n&gt;     main()\r\n\r\n\r\n&lt;/deta