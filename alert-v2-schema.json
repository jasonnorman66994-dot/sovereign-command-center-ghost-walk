{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOC Alert Payload",
  "type": "object",
  "required": ["alert_id", "timestamp", "severity", "category", "user", "event", "enrichment", "recommendation"],
  "properties": {
    "alert_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "category": { "type": "string" },
    "user": {
      "type": "object",
      "required": ["email", "display_name", "user_id", "role", "privilege_level"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "display_name": { "type": "string" },
        "user_id": { "type": "string" },
        "role": { "type": "string" },
        "privilege_level": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "event": { "type": "object" },
    "enrichment": { "type": "object" },
    "recommendation": {
      "type": "object",
      "required": ["action", "urgency"],
      "properties": {
        "action": { "type": "string" },
        "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      }
    }
  },
  "examples": []
}
