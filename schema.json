{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Identity Threat Alert Payload",
  "description": "Production-ready schema for identity threat and MFA bypass alerts",
  "type": "object",
  "required": [
    "alert_type",
    "severity",
    "timestamp_utc",
    "user",
    "event",
    "technical_indicators",
    "recommended_actions",
    "investigation_links",
    "assigned_to",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "alert_type": {
      "type": "string",
      "enum": ["identity_compromise", "identity_endpoint_compromise"],
      "description": "Classification of the alert type"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Alert severity level with emoji prefix: 🟢 🟡 🟠 🔴"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of the alert"
    },
    "user": {
      "type": "object",
      "required": ["email", "user_id", "display_name", "department", "role", "privileged_access"],
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's primary email / UPN"
        },
        "user_id": {
          "type": "string",
          "description": "Azure AD / Entra ID user object ID"
        },
        "display_name": {
          "type": "string",
          "description": "User's display name"
        },
        "department": {
          "type": "string",
          "description": "Department from user profile"
        },
        "role": {
          "type": "string",
          "description": "Job title or role"
        },
        "privileged_access": {
          "type": "boolean",
          "description": "Whether user has privileged access (admin, exec, etc.)"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "event_type", "description", "source_ip", "asn", "geo_location",
        "client_app", "auth_method", "risk_level", "risk_detections",
        "correlation_id", "session_id"
      ],
      "properties": {
        "event_type": { "type": "string" },
        "description": { "type": "string" },
        "source_ip": { "type": "string" },
        "asn": { "type": "string" },
        "geo_location": { "type": "string" },
        "client_app": { "type": "string" },
        "auth_method": { "type": "string" },
        "risk_level": { "type": "string" },
        "risk_detections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "correlation_id": { "type": "string" },
        "session_id": { "type": "string" }
      }
    },
    "technical_indicators": {
      "type": "object",
      "properties": {
        "mfa_fatigue_count": { "type": ["integer", "string"] },
        "legacy_protocol_used": { "type": "boolean" },
        "oauth_app_detected": { "type": "boolean" },
        "oauth_app_scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hidden_inbox_rules_detected": { "type": "boolean" },
        "impossible_travel_detected": { "type": "boolean" },
        "token_replay_detected": { "type": "boolean" },
        "new_device_registration": { "type": "boolean" },
        "unfamiliar_signin_properties": { "type": "boolean" }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "investigation_links": {
      "type": "object",
      "properties": {
        "signin_logs": { "type": "string" },
        "oauth_apps": { "type": "string" },
        "inbox_rules": { "type": "string" },
        "sentinel_query": { "type": "string" },
        "user_profile": { "type": "string" }
      }
    },
    "assigned_to": {
      "type": "object",
      "properties": {
        "analyst": { "type": "string" },
        "team": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "pipeline_version": { "type": "string" },
        "source_system": { "type": "string" },
        "environment": { "type": "string" }
      }
    }
  },
  "example": {
    "alert_type": "identity_compromise",
    "severity": "critical",
    "timestamp_utc": "2026-04-23T09:12:44Z",
    "user": {
      "email": "ceo@company.com",
      "user_id": "88421",
      "display_name": "CEO, Global Ops",
      "department": "Executive",
      "role": "Privileged User",
      "privileged_access": true
    },
    "event": {
      "event_type": "mfa_fatigue_attack",
      "description": "User received 17 MFA push prompts in 3 minutes. Spoofed IT support call reported.",
      "source_ip": "185.221.102.44",
      "asn": "AS20860",
      "geo_location": "Bucharest, Romania",
      "client_app": "Browser",
      "auth_method": "MFA Push",
      "risk_level": "high",
      "risk_detections": [
        "Repeated MFA prompts",
        "Unusual ASN",
        "Successful login after fatigue pattern"
      ],
      "correlation_id": "c0ffee-1234-5678-90ab-cafe12345678",
      "session_id": "session-998877"
    },
    "technical_indicators": {
      "mfa_fatigue_count": 17,
      "legacy_protocol_used": false,
      "oauth_app_detected": false,
      "oauth_app_scopes": [],
      "hidden_inbox_rules_detected": false,
      "impossible_travel_detected": false,
      "token_replay_detected": false,
      "new_device_registration": false,
      "unfamiliar_signin_properties": false
    },
    "recommended_actions": [
      "Revoke all active sessions",
      "Block the account",
      "Reset password",
      "Reset MFA bindings",
      "Review OAuth grants",
      "Check for hidden inbox rules"
    ],
    "investigation_links": {
      "signin_logs": "https://entra.microsoft.com/#view/Microsoft_AAD_IAM/UsersSignIns",
      "oauth_apps": "https://entra.microsoft.com/#view/Microsoft_AAD_IAM/Apps",
      "inbox_rules": "https://admin.exchange.microsoft.com/#/mailboxes",
      "sentinel_query": "https://portal.azure.com/#blade/Microsoft_Azure_Sentinel/Logs",
      "user_profile": "https://entra.microsoft.com/#view/Microsoft_AAD_UsersProfile"
    },
    "assigned_to": {
      "analyst": "@oncall_analyst",
      "team": "Security Operations Center"
    },
    "metadata": {
      "pipeline_version": "1.2.3",
      "source_system": "Sentinel",
      "environment": "production"
    }
  }
}
